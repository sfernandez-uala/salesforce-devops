<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <capabilities>
        <capability>lightning__dynamicComponent</capability>
    </capabilities>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <objects>
                <object>Account</object>
            </objects>
            <!-- No default on purpose: a fallback would leave a newly placed
                 component rendering another tab's cards and looking configured
                 while nobody had chosen anything.

                 Not marked required either, though it is: Salesforce refuses to
                 change a property's requiredness once the component sits on a
                 Lightning page, so the component enforces it itself by
                 rendering a state that names the gap. -->
            <property
                name="tabApiName"
                type="String"
                label="Tab"
                datasource="apex://V360TabPicklist"
                description="Which configured Vista 360 tab this placement renders. The list offers the tabs anchored on this page's object; without one the component renders nothing."
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
