<?xml version="1.0" encoding="UTF-8"?>
<Package xmlns="http://soap.sforce.com/2006/04/metadata">
    <!--
        Renamed, not removed: a rename in source leaves the old bundle behind in
        every org that already had it, and nothing in a deploy notices. The
        wrapper is domain-free — it knows nothing about Vista 360 — so it is now
        c/emptyState, named for what it does rather than for the feature that
        happened to need it first.
    -->
    <!--
        Superseded, and with nothing left pointing at it: the V360_Admin_Console
        tab renders c/v360AdminBuilder now, and that tab is the only one the
        V360_Admin permission set grants. The console had already stopped being
        reachable; leaving the bundle in the org only invited edits to a screen
        no one could open.

        The V360_Admin_Builder tab goes with it: a second tab onto the same
        component, where V360_Admin_Console is the one the V360_Admin
        permission set grants and therefore the only one anybody opens.
    -->
    <types>
        <members>v360EmptyState</members>
        <members>v360AdminConsole</members>
        <name>LightningComponentBundle</name>
    </types>
    <types>
        <members>V360_Admin_Builder</members>
        <name>CustomTab</name>
    </types>
    <version>67.0</version>
</Package>
